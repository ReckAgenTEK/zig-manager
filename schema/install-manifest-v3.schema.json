{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsr.io/@reckagentek/zig-manager/install-manifest-v3.schema.json",
  "title": "zig-manager immutable install manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installationId",
    "component",
    "identity",
    "source",
    "paths",
    "executable",
    "runtime",
    "commands",
    "dependencies",
    "createdAt",
    "verifierContractVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "installationId": { "$ref": "#/$defs/hash" },
    "component": { "enum": ["zig", "zls"] },
    "identity": { "$ref": "build-recipe-v1.schema.json" },
    "source": { "$ref": "#/$defs/resolvedSource" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "libraries"],
      "properties": {
        "executable": { "$ref": "#/$defs/installPath" },
        "libraries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/installPath" }
        }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "hostTarget", "size", "sha256", "format"],
      "properties": {
        "version": { "$ref": "#/$defs/text" },
        "hostTarget": { "$ref": "#/$defs/text" },
        "size": { "$ref": "#/$defs/positiveInteger" },
        "sha256": { "$ref": "#/$defs/hash" },
        "format": { "$ref": "#/$defs/elfFormat" }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["linkage"],
          "properties": { "linkage": { "const": "static" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["linkage", "interpreter", "dependencies"],
          "properties": {
            "linkage": { "const": "dynamic" },
            "interpreter": { "$ref": "#/$defs/runtimeDependency" },
            "dependencies": {
              "type": "array",
              "items": { "$ref": "#/$defs/runtimeDependency" }
            }
          }
        }
      ]
    },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "verifierContractVersion": { "$ref": "#/$defs/positiveInteger" }
  },
  "allOf": [
    {
      "if": { "properties": { "component": { "const": "zig" } }, "required": ["component"] },
      "then": { "properties": { "dependencies": { "maxItems": 0 } } },
      "else": { "properties": { "dependencies": { "minItems": 1, "maxItems": 1 } } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "plainString": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "url"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base",
        "text",
        "taggedAncestor",
        "commitsAfterTag",
        "commitAbbreviation"
      ],
      "properties": {
        "kind": { "enum": ["release", "development"] },
        "base": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "text": { "$ref": "#/$defs/text" },
        "taggedAncestor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "commitsAfterTag": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "commitAbbreviation": { "type": "string", "pattern": "^[0-9a-f]{4,64}$" }
      }
    },
    "zlsSourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "declaredVersion",
        "base",
        "text",
        "versionString",
        "taggedAncestor",
        "commitsAfterTag",
        "commitAbbreviation"
      ],
      "properties": {
        "kind": { "enum": ["release", "development"] },
        "declaredVersion": { "$ref": "#/$defs/text" },
        "base": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "text": { "$ref": "#/$defs/text" },
        "versionString": { "$ref": "#/$defs/text" },
        "taggedAncestor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "commitsAfterTag": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "commitAbbreviation": { "type": "string", "pattern": "^[0-9a-f]{4,64}$" }
      }
    },
    "resolvedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["head", "tag", "branch", "commit"] },
        "value": { "$ref": "#/$defs/text" }
      }
    },
    "resolvedSource": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedLegacySource" },
        { "$ref": "#/$defs/resolvedZlsSource" }
      ]
    },
    "resolvedLegacySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "repository",
        "requestedSelector",
        "resolvedRef",
        "commit",
        "version",
        "versionMetadata",
        "resolvedAt"
      ],
      "properties": {
        "component": { "enum": ["zig", "zls"] },
        "repository": { "$ref": "#/$defs/repository" },
        "requestedSelector": { "$ref": "#/$defs/text" },
        "resolvedRef": { "$ref": "#/$defs/resolvedRef" },
        "commit": { "$ref": "#/$defs/commit" },
        "version": { "$ref": "#/$defs/text" },
        "versionMetadata": { "$ref": "#/$defs/sourceVersion" },
        "resolvedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "resolvedZlsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "repository",
        "requestedSelector",
        "resolvedRef",
        "commit",
        "version",
        "versionMetadata",
        "resolvedAt"
      ],
      "properties": {
        "component": { "const": "zls" },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "url"],
          "properties": {
            "identity": { "const": "github/zls" },
            "url": { "const": "https://github.com/zigtools/zls.git" }
          }
        },
        "requestedSelector": { "$ref": "#/$defs/text" },
        "resolvedRef": { "$ref": "#/$defs/resolvedRef" },
        "commit": { "$ref": "#/$defs/commit" },
        "version": { "$ref": "#/$defs/text" },
        "versionMetadata": { "$ref": "#/$defs/zlsSourceVersion" },
        "resolvedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "installPath": {
      "type": "string",
      "pattern": "^install/(?![./](?:/|$))[^\\\\/\\u0000-\\u001f\\u007f-\\u009f]+(?:/(?![.]{1,2}(?:/|$))[^\\\\/\\u0000-\\u001f\\u007f-\\u009f]+)*$"
    },
    "absolutePath": { "type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "elfFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "class",
        "endianness",
        "machine",
        "type",
        "dynamicallyLinked",
        "interpreter"
      ],
      "properties": {
        "format": { "const": "elf" },
        "class": { "const": 64 },
        "endianness": { "const": "little" },
        "machine": { "const": "x86_64" },
        "type": { "enum": ["executable", "shared"] },
        "dynamicallyLinked": { "type": "boolean" },
        "interpreter": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/absolutePath" }] }
      }
    },
    "runtimeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "size", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "size": { "$ref": "#/$defs/positiveInteger" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "cwd", "env", "clearEnv"],
      "properties": {
        "executable": { "$ref": "#/$defs/text" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/plainString" } },
        "cwd": { "$ref": "#/$defs/text" },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/plainString" }
        },
        "clearEnv": { "const": true }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "installationId"],
      "properties": {
        "component": { "const": "zig" },
        "installationId": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
