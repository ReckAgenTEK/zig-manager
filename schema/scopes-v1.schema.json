{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsr.io/@reckagentek/zig-manager/scopes-v1.schema.json",
  "title": "zig-manager advisory scope registry v1",
  "description": "Entries are strictly sorted by scopeRoot without duplicates; runtime scope resolution does not trust this advisory registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scopes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scopes": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "$ref": "#/$defs/scope"
      }
    }
  },
  "$defs": {
    "profileId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scopeRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeRoot",
        "profileId",
        "lastOperation",
        "updatedAt"
      ],
      "properties": {
        "scopeRoot": {
          "$ref": "#/$defs/scopeRoot"
        },
        "profileId": {
          "$ref": "#/$defs/profileId"
        },
        "lastOperation": {
          "$ref": "#/$defs/operation"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
