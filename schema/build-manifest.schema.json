{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsr.io/@zignado/zig-manager/build-manifest.schema.json",
  "title": "zig-manager build manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "source",
    "hostTarget",
    "configuration",
    "paths",
    "commands",
    "compiler",
    "verified"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "identity": {
      "$ref": "#/$defs/hash"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "hostTarget": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "commands": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "size"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "verified": {
      "const": true
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base",
        "text",
        "taggedAncestor",
        "commitsAfterTag",
        "commitAbbreviation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "release",
            "development"
          ]
        },
        "base": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "text": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "taggedAncestor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "commitsAfterTag": {
          "type": "integer",
          "minimum": 0
        },
        "commitAbbreviation": {
          "type": "string",
          "pattern": "^[0-9a-f]{4,64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "version",
        "commit"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/sourceVersion"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "hostTarget",
        "options",
        "tools"
      ],
      "properties": {
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "hostTarget": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "profile",
            "cmakeBuildType",
            "generator",
            "jobs",
            "cmakePrefixPath"
          ],
          "properties": {
            "strategy": {
              "const": "cmake"
            },
            "profile": {
              "enum": [
                "debug",
                "release",
                "relwithdebinfo",
                "minsizerel"
              ]
            },
            "cmakeBuildType": {
              "enum": [
                "Debug",
                "Release",
                "RelWithDebInfo",
                "MinSizeRel"
              ]
            },
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "jobs": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "cmakePrefixPath": {
              "type": "string"
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmake",
            "cCompiler",
            "cxxCompiler",
            "llvmConfig",
            "clang",
            "lld",
            "generatorTool"
          ],
          "properties": {
            "cmake": {
              "$ref": "#/$defs/tool"
            },
            "cCompiler": {
              "$ref": "#/$defs/tool"
            },
            "cxxCompiler": {
              "$ref": "#/$defs/tool"
            },
            "llvmConfig": {
              "$ref": "#/$defs/tool"
            },
            "clang": {
              "$ref": "#/$defs/tool"
            },
            "lld": {
              "$ref": "#/$defs/tool"
            },
            "generatorTool": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/tool"
                }
              ]
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "cmakeBuild",
        "install",
        "cache",
        "logs",
        "executable",
        "lib"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "cmakeBuild": {
          "type": "string",
          "minLength": 1
        },
        "install": {
          "type": "string",
          "minLength": 1
        },
        "cache": {
          "type": "string",
          "minLength": 1
        },
        "logs": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "lib": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "args",
        "cwd",
        "env"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
